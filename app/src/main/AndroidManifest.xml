<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Android 12+ (API 31+) -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Android 12及以下 -->
    <uses-permission android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />

    <!-- 位置权限 (BLE扫描需要) -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- livetiming 圈速上报 (livetiming-lap-upload · 首个网络栈) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 视频录制 (Phase 2 · camera-module-and-permission · L0-2 录音频) -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- 视频导出 (Phase 2 · video-export-burned-overlay · Round B) -->
    <!-- API 28：MediaStore.Video 写需 WRITE_EXTERNAL_STORAGE（仅 28 申请；API29+ scoped storage 无需权限） -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <!-- 前台 Service 跑导出 drain loop -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- 前台 Service 数据处理类型（导出烧录=CPU/编解码数据处理；mediaProcessing 是 API35 与 compileSdk34 不兼容，用 dataSync） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- API 33：进度通知可见（不强制；缺失仅通知不显示，Service 仍运行） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />



    <uses-feature
        android:name="android.hardware.bluetooth"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />

    <application
        android:name=".BlazePushApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.BlazePush"
        android:networkSecurityConfig="@xml/network_security_config"
        tools:targetApi="31">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 视频导出前台 Service (video-export-burned-overlay · Round B) -->
        <service
            android:name="com.blazepush.feature.test.export.VideoExportService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Share-only VBO cache. Paths XML exposes only cache/shared_vbo, never the cache root. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/vbo_share_paths" />
        </provider>
    </application>

</manifest>
